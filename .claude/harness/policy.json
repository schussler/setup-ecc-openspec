{
  "version": "1.0.0",
  "reserve_margin_ratio": 0.25,
  "max_corrections_per_gate": 3,
  "max_invocations_per_change": 60,
  "max_invocations_per_slice": 12,
  "max_usd_per_call": 2,
  "max_usd_per_change": 30,
  "max_seconds_per_call": 1500,
  "max_seconds_per_change": 10800,
  "max_diagnostics_per_signature": 2,
  "lock_stale_seconds": 900,
  "log_retention_days": 90,
  "protected_paths": [
    "openspec/changes/*/proposal.md",
    "openspec/changes/*/design.md",
    "openspec/changes/*/specs",
    "scripts/test/harness",
    "scripts/gates",
    "scripts/harness",
    ".claude/harness",
    "template.json:checks"
  ],
  "excluded_paths": [
    "run-state*",
    "gates.json",
    "summary.md",
    ".harness-local/",
    "relatorios/",
    "node_modules/",
    "dist/",
    "coverage/",
    "__pycache__/",
    ".git/",
    "docs/agents/issue-tracker.md"
  ],
  "states": [
    "ready",
    "invoking",
    "awaiting_gate",
    "correction_requested",
    "approved",
    "awaiting_decision",
    "interrupted",
    "config_blocked",
    "diagnosing",
    "forbidden_action_stopped"
  ],
  "stop_reasons": [
    "correction_limit",
    "budget_exhausted",
    "budget_reserve_insufficient",
    "repeated_symptom",
    "protected_change",
    "config_error",
    "invalid_evidence",
    "quota_unavailable",
    "permission_denied",
    "time_limit",
    "human_decision_needed",
    "stale_lock",
    "lock_held",
    "reconciliation_required",
    "mode_mismatch",
    "timeout_unclassified",
    "authorization_required",
    "lock_unreadable"
  ],
  "non_sensitive_config": [
    "node_version",
    "claude_cli_version",
    "model",
    "effort"
  ],
  "max_seconds_per_gate": 1500,
  "allowed_exceptions": []
}
