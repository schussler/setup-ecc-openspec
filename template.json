{
  "template": {
    "repo": "https://github.com/schussler/setup-ecc-openspec.git",
    "branch": "main"
  },
  "upstreams": {
    "ecc": "2.2.3",
    "openspec": "1.14.3",
    "mattpocock-skills": "5beb35b040e3de97e54fa9e386d7e42d15c295c2"
  },
  "managed": [
    ".claude/rules/common",
    ".claude/rules/openspec.md",
    ".claude/rules/README.md",
    ".claude/agents",
    ".claude/skills",
    ".claude/commands/opsx",
    ".claude/commands/toolset-retro.md",
    "scripts/gates",
    ".claude/harness",
    "scripts/harness"
  ],
  "owned": [
    "CLAUDE.md",
    "README.md",
    "openspec/config.yaml",
    "openspec/changes",
    "openspec/specs",
    ".claude/rules/project",
    "docs/agents",
    ".claude/settings.json",
    ".harness-project.json"
  ],
  "template_only": [
    "templates",
    "scripts/benchmark",
    "scripts/test",
    "scripts/test/harness",
    "openspec/specs",
    "openspec/changes/archive"
  ],
  "checks": {
    "test": {
      "command": "node --test \"scripts/test/**/*.test.mjs\"",
      "suite": "template"
    },
    "test_report": {
      "command": "node --test --test-reporter=tap \"scripts/test/**/*.test.mjs\"",
      "suite": "template",
      "format": "tap",
      "file_command": "node --test --test-reporter=tap {file}",
      "files": "scripts/test/**/*.test.mjs"
    },
    "test_file": "node --test {file}",
    "lint": "node scripts/gates/lint.mjs",
    "typecheck": "node scripts/gates/syntax-check.mjs scripts .claude/skills/template-migrate"
  }
}
